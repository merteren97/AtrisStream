        android:pathData="M126,138 L194,138 C195.5,138 196.5,139 196.5,140.5 C196.5,142 195.5,143 194,143 L126,143 C124.5,143 123.5,142 123.5,140.5 C123.5,139 124.5,138 126,138 Z" />
