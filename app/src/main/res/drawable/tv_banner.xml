    <!-- Play Triangle -->
    <path android:pathData="M148,72 L182,90 L148,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="182"
                android:endY="108"
                android:startX="148"
                android:startY="72"
                android:type="linear">
                <item
                    android:color="#38BDF8"
                    android:offset="0.0" />
                <item
                    android:color="#818CF8"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

