    <!-- Dark Cinematic Background -->
    <path android:pathData="M0,0 L320,0 L320,180 L0,180 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="320"
                android:endY="180"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item
                    android:color="#FF0B0E14"
                    android:offset="0.0" />
                <item
                    android:color="#FF141923"
                    android:offset="0.6" />
                <item
                    android:color="#FF1C2331"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Glow Circle -->
    <path
        android:fillAlpha="0.14"
        android:fillColor="#38BDF8"
        android:pathData="M160,90 m-72,0 a72,72 0 1,0 144,0 a72,72 0 1,0 -144,0" />

